<!DOCTYPE html>
<html lang="am">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>የተማሪዎች መቆጣጠሪያ መዝገብ</title>
    <style>
        body {
            font-family: sans-serif;
            margin: 10px;
            background-color: #f4f7f6;
            direction: ltr;
        }

        .container {
            max-width: 100%;
            background: #fff;
            padding: 12px;
            border-radius: 8px;
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        }

        .header-section {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-bottom: 15px;
            align-items: center;
        }

        select, input[type="text"], button {
            padding: 8px;
            border: 1px solid #ccc;
            border-radius: 5px;
            font-size: 14px;
        }

        input[type="text"] {
            width: 150px;
        }

        button.add-btn {
            background-color: #1e5631;
            color: white;
            border: none;
            font-weight: bold;
            cursor: pointer;
        }

        .table-wrapper {
            overflow-x: auto;
            max-width: 100%;
            border: 1px solid #000;
        }

        table {
            border-collapse: separate;
            border-spacing: 0;
            width: 100%;
            font-size: 12px;
        }

        th, td {
            border-right: 1px solid #000;
            border-bottom: 1px solid #000;
            padding: 5px 2px;
            text-align: center;
            background-color: #fff;
        }

        th {
            background-color: #1e5631;
            color: white;
        }

        .row-no-col {
            min-width: 30px;
            position: sticky;
            left: 0;
            background-color: #fff;
            z-index: 2;
        }

        .name-col {
            min-width: 100px;
            max-width: 100px;
            text-align: left;
            padding-left: 5px;
            font-weight: bold;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            position: sticky;
            left: 31px;
            background-color: #fff;
            z-index: 2;
            border-right: 2px solid #000;
        }

        th.row-no-col, th.name-col {
            background-color: #1e5631;
            color: white;
            z-index: 3;
        }

        .day-col {
            min-width: 30px;
        }

        .delete-col {
            min-width: 55px;
        }

        .att-box {
            width: 100%;
            font-weight: bold;
            font-size: 14px;
            cursor: pointer;
            display: block;
        }

        .delete-btn {
            background-color: #ff4d4d;
            color: white;
            border: none;
            padding: 3px 5px;
            border-radius: 4px;
            font-size: 11px;
            cursor: pointer;
        }

        .option-popup {
            display: none;
            position: fixed;
            top: 50%; left: 50%;
            transform: translate(-50%, -50%);
            background: white;
            padding: 15px;
            border-radius: 8px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.4);
            z-index: 1000;
            text-align: center;
        }

        .opt-btn {
            padding: 8px 12px;
            margin: 4px;
            border: 1px solid #ccc;
            border-radius: 5px;
            font-weight: bold;
            cursor: pointer;
        }

        .overlay {
            display: none;
            position: fixed;
            top: 0; left: 0;
            width: 100%; height: 100%;
            background: rgba(0,0,0,0.4);
            z-index: 999;
        }
    </style>
</head>
<body>

<div class="container">
    <div class="header-section">
        <label><strong>ወር፦</strong></label>
        <select id="monthSelect" onchange="loadData()">
            <option>መስከረም</option>
            <option>ጥቅምት</option>
            <option>ሕዳር</option>
            <option>ታኅሣሥ</option>
            <option>ጥር</option>
            <option>የካቲት</option>
            <option>መጋቢት</option>
            <option>ሚያዝያ</option>
            <option>ግንቦት</option>
            <option>ሰኔ</option>
            <option>ሐምሌ</option>
            <option>ነሐሴ</option>
        </select>

        <input type="text" id="studentNameInput" placeholder="የተማሪ ስም ያስገቡ...">
        <button type="button" class="add-btn" onclick="addStudent()">መዝግብ</button>
    </div>

    <div class="table-wrapper">
        <table>
            <thead>
                <tr id="tableHeader">
                    <th class="row-no-col">ተ.ቁ</th>
                    <th class="name-col">የተማሪ ስም</th>
                </tr>
            </thead>
            <tbody id="studentTableBody">
            </tbody>
        </table>
    </div>
</div>

<div class="overlay" id="overlay" onclick="closePopup()"></div>
<div class="option-popup" id="optionPopup">
    <h4>ሁኔታ ይምረጡ፦</h4>
    <button type="button" class="opt-btn" style="color:green" onclick="selectStatus('✓', 'green')">✓ የተገኘ</button>
    <button type="button" class="opt-btn" style="color:red" onclick="selectStatus('X', 'red')">X የቀረ</button>
    <button type="button" class="opt-btn" style="color:blue" onclick="selectStatus('ፈ', 'blue')">ፈ ፈቃድ</button>
    <button type="button" class="opt-btn" onclick="selectStatus('-', 'black')">- ባዶ</button>
</div>

<script>
    var studentsData = [];
    var activeStudentIndex = null;
    var activeDayIndex = null;

    // 1. የ30 ቀናት ሄደር መፍጠር
    var tableHeader = document.getElementById('tableHeader');
    for (var i = 1; i <= 30; i++) {
        var th = document.createElement('th');
        th.className = 'day-col';
        th.textContent = i;
        tableHeader.appendChild(th);
    }
    var deleteTh = document.createElement('th');
    deleteTh.className = 'delete-col';
    deleteTh.textContent = 'ሰርዝ';
    tableHeader.appendChild(deleteTh);

    // 2. ዳታ መጫን (Load Data)
    function loadData() {
        var month = document.getElementById('monthSelect').value;
        try {
            var data = localStorage.getItem('attendance_' + month);
            studentsData = data ? JSON.parse(data) : [];
        } catch(e) {
            studentsData = [];
        }
        renderTable();
    }

    // 3. ዳታ ማስቀመጥ (Save Data)
    function saveData() {
        var month = document.getElementById('monthSelect').value;
        try {
            localStorage.setItem('attendance_' + month, JSON.stringify(studentsData));
        } catch(e) {}
    }

    // 4. ቴብል መሳል (Render Table)
    function renderTable() {
        var tbody = document.getElementById('studentTableBody');
        tbody.innerHTML = '';

        for (var s = 0; s < studentsData.length; s++) {
            var student = studentsData[s];
            var tr = document.createElement('tr');

            var html = '<td class="row-no-col">' + (s + 1) + '</td>';
            html += '<td class="name-col" title="' + student.name + '">' + student.name + '</td>';

            for (var d = 0; d < 30; d++) {
                var att = (student.attendance && student.attendance[d]) ? student.attendance[d] : { symbol: '-', color: 'black' };
                html += '<td class="day-col"><span class="att-box" style="color:' + att.color + '" onclick="openPopup(' + s + ',' + d + ')">' + att.symbol + '</span></td>';
            }

            html += '<td class="delete-col"><button type="button" class="delete-btn" onclick="deleteRow(' + s + ')">🗑️</button></td>';

            tr.innerHTML = html;
            tbody.appendChild(tr);
        }
    }

    // 5. አዲስ ተማሪ መመዝገብ (የተስተካከለ)
    function addStudent() {
        var input = document.getElementById('studentNameInput');
        var name = input.value;

        if (!name || name.trim() === '') {
            alert('እባክዎን የተማሪ ስም ያስገቡ!');
            return;
        }

        // 30 ቀናት ባዶ አቴንዳንስ ማዘጋጀት
        var newAttendance = [];
        for (var i = 0; i < 30; i++) {
            newAttendance.push({ symbol: '-', color: 'black' });
        }

        // አዲሱን ተማሪ መመዝገብ
        studentsData.push({
            name: name.trim(),
            attendance: newAttendance
        });

        saveData();
        renderTable();

        input.value = '';
    }

    // 6. ፖፕአፕ መክፈት
    function openPopup(sIndex, dIndex) {
        activeStudentIndex = sIndex;
        activeDayIndex = dIndex;
        document.getElementById('overlay').style.display = 'block';
        document.getElementById('optionPopup').style.display = 'block';
    }

    // 7. የአቴንዳንስ ሁኔታ መምረጥ
    function selectStatus(symbol, color) {
        if (activeStudentIndex !== null && activeDayIndex !== null) {
            if (!studentsData[activeStudentIndex].attendance) {
                studentsData[activeStudentIndex].attendance = [];
            }
            studentsData[activeStudentIndex].attendance[activeDayIndex] = { symbol: symbol, color: color };
            saveData();
            renderTable();
        }
        closePopup();
    }

    function closePopup() {
        document.getElementById('overlay').style.display = 'none';
        document.getElementById('optionPopup').style.display = 'none';
        activeStudentIndex = null;
        activeDayIndex = null;
    }

    // 8. ተማሪ መሰረዝ
    function deleteRow(index) {
        if (confirm("ተማሪውን ከመዝገብ መሰረዝ ይፈልጋሉ?")) {
            studentsData.splice(index, 1);
            saveData();
            renderTable();
        }
    }

    // ገጹ ሲከፈት ዳታውን ይጫናል
    loadData();
</script>

</body>
</html>

